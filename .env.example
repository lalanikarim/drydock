# Factory PoC environment (copy to poc-factory/.env; never commit .env)

# Local model endpoint (OpenAI-compatible, e.g. Unsloth on your inference host).
# Copy to poc/.env and set the real URL for your machine — never commit .env.
OPENAI_BASE_URL=http://<inference-host>:8888/v1
OPENAI_API_KEY=<key>

# GitHub access for host-side operations (issue fetch, push, PR create).
# Leave unset to use stored `gh` auth on this machine.
FACTORY_GITHUB_TOKEN=

# Per-repo config file (multi-repo plan §3.1). When set, it defines repo,
# sandbox image, test command, and budgets — and wins over the env fallbacks
# below. See poc/config/factory-fixture.json for the shape.
FACTORY_CONFIG=

# Legacy single-repo fallback (used only when FACTORY_CONFIG is unset).
# Fixture repo (owner/name) the factory implements issues in.
FIXTURES_REPO=lalanikarim/factory-fixture

# Git identity for worker commits (host-side, inside the workspace clone).
# LEAVE THESE EMPTY. By default the identity is derived from the credential in use, so commits
# name the same principal that opens the pull request — no id to copy and nothing deployment-
# specific to commit. Override only to attribute commits elsewhere: put the real values in .env,
# never here, and set both or neither (a half-set override is a boot error).
# Attribution is not verification — commits are unsigned either way.
FACTORY_GIT_NAME=
FACTORY_GIT_EMAIL=

# Sandbox containment policy (plan §3.6; factory-level, NOT per-repo config —
# repo configs may select from the allowlist but never widen it).
# Comma-separated base-image allowlist for worker/reviewer/setup containers.
# Default: factory-sandbox:latest (the factory default image).
SANDBOX_ALLOW_IMAGES=
# Host root under which all sandbox workspaces must live.
# Default: this factory's own work dir.
SANDBOX_MOUNT_ROOT=

# Webhook secret for the intake adapter's X-Hub-Signature-256 verification.
# Per-repo by design: this factory serves FIXTURES_REPO, so this is THAT
# repo's webhook secret (set the same value in that repo's GitHub webhook
# config). REQUIRED when running `01-intake-g0.mjs serve --host 0.0.0.0`
# (or any non-loopback bind).
GITHUB_WEBHOOK_SECRET=

# GitHub App credentials (decision B1-rev: the App is the factory credential — no PAT). These are the
# preferred source and are what clone, push, pull-request creation, review-pull, merge-gate reads and
# the boot check all use. A legacy FACTORY_GITHUB_TOKEN still works as a fallback but is not recommended:
# 30-day full-repo PAT vs an hourly installation token scoped to the App's selected repositories.
# All three required for App mode (partial config is a startup error); private key read once per mint.
# Verify the live installation any time with:
#   node gates/github-app-check.mjs
GITHUB_APP_ID=
# Path to the App's PEM private key. Keep it OUTSIDE the repository; .env is gitignored, but a key
# inside the tree is one `git add -A` away from being committed by someone else's tooling.
GITHUB_APP_PRIVATE_KEY_PATH=<path-outside-repo>/app.pem
GITHUB_APP_INSTALLATION_ID=
# Optional fast path for commit identity: the App's URL slug. Without it the bot account is resolved by
# exchanging the App JWT for /app metadata at boot — one extra call, same result. Set it if that call
# should not be on your critical path, or to make derivation independent of App-level API access.
GITHUB_APP_SLUG=
