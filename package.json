{
  "name": "drydock",
  "version": "0.2.0",
  "description": "Multi-repo software factory built on the engram core (createCoreInstance seam).",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "croner": "^11.0.0"
  },
  "scripts": {
    "verify": "npm run typecheck && npm test",
    "test": "node --experimental-strip-types factory/pipeline.test.ts && node --experimental-strip-types factory/intake.test.ts && node --experimental-strip-types --test 'test/*.test.mjs'",
    "test:boot": "node --experimental-strip-types factory/core-spike.test.ts && node --experimental-strip-types factory/pipeline-boot.test.ts && node --experimental-strip-types factory/intake-boot.test.ts",
    "gate:verification": "node gates/verification-sandbox-live.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
