 test("toCsv renders a missing field as empty", () => {
   assert.equal(toCsv([{ id: 1 }], { columns: ["id", "customerId"] }), "id,customerId\n1,");
 });
+
+// HTTP-level behavior of GET /exports/invoices (issue #94): a valid `columns`
+// list returns the CSV, and a missing or malformed value is rejected with a
+// 4xx naming the caller's problem — never a 500 from inside the engine.
+let ctx;
+
+test.before(async () => {
+  ctx = await startServer({});
+});
+
+test.after(() => {
+  ctx.server.close();
+});
+
+async function api(method, path, body) {
+  const res = await fetch(`http://127.0.0.1:${ctx.port}${path}`, {
+    method,
+    headers: body ? { "content-type": "application/json" } : {},
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  return { status: res.status, body: await res.json() };
+}
+
+test("exports invoices returns 200 with a csv projection for valid columns", async () => {
+  const created = await api("POST", "/invoices", { customerId: "export-c1", amountCents: 500 });
+  const res = await api("GET", "/exports/invoices?columns=id,customerId,amountCents");
+  assert.equal(res.status, 200);
+  assert.ok(typeof res.body.csv === "string");
+  const lines = res.body.csv.split("\n");
+  assert.equal(lines[0], "id,customerId,amountCents");
+  assert.ok(lines.some((line) => line === `${created.body.id},export-c1,500`));
+});
+
+test("exports invoices with a single column works", async () => {
+  await api("POST", "/invoices", { customerId: "export-single", amountCents: 75 });
+  const res = await api("GET", "/exports/invoices?columns=customerId");
+  assert.equal(res.status, 200);
+  assert.ok(res.body.csv.split("\n").some((line) => line === "export-single"));
+});
+
+test("exports invoices without columns returns 400 naming the missing value", async () => {
+  const res = await api("GET", "/exports/invoices");
+  assert.equal(res.status, 400);
+  assert.ok(res.body.error);
+  assert.match(res.body.error, /columns/);
+});
+
+test("exports invoices with malformed columns returns 400 (not 500) describing the value", async () => {
+  for (const bad of ["", ",", "id,,name", "id,", ",id", " , "]) {
+    const res = await api("GET", `/exports/invoices?columns=${encodeURIComponent(bad)}`);
+    assert.equal(res.status, 400, `expected 400 for columns=${JSON.stringify(bad)}, got ${res.status}: ${res.body.error}`);
+    assert.ok(res.body.error);
+    // The error describes the caller's value, not engine internals.
+    assert.doesNotMatch(res.body.error, /join|properties of null/);
+  }
+});
