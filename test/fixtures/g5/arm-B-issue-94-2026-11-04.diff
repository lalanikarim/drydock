+// GET /exports/invoices?columns=a,b — `columns` must be a non-empty
+// comma-separated list of column names. A missing or malformed value is a
+// client error (400) describing the caller's input, not an engine failure.
+class InvalidColumnsError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = "InvalidColumnsError";
+    this.statusCode = 400;
+  }
+}
+
+// Single guard for the `columns` query parameter: rejects a missing value and
+// any list containing an empty entry, and returns the parsed column array.
+function parseColumnsParam(param) {
+  if (param === null) {
+    throw new InvalidColumnsError('missing required query parameter: "columns"');
+  }
+  const columns = param.split(",");
+  if (columns.some((column) => column.trim() === "")) {
+    throw new InvalidColumnsError(`columns must be a comma-separated list of column names, got: ${param}`);
+  }
+  return columns;
+}
