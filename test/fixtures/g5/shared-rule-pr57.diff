+++ b/src/invoices.mjs
@@ -35,8 +35,41 @@ function sendJson(res, status, body) {
   res.end(JSON.stringify(body));
 }
 
+// Thrown when a request body contains a field the endpoint does not accept.
+class UnsupportedFieldError extends Error {
+  constructor(field) {
+    super(`unsupported field: ${field}`);
+    this.name = "UnsupportedFieldError";
+    this.statusCode = 400;
+    this.field = field;
+  }
+}
+
+// The body fields each invoice endpoint accepts. Both the create and update
+// paths go through rejectUnknownFields with these sets, so "is this field
+// allowed" lives in one place and cannot drift into two implementations.
+const CREATE_FIELDS = new Set(["customerId", "amountCents", "status"]);
+const UPDATE_FIELDS = new Set(["amountCents"]);
+
+// Rejects the first unknown body key (in JSON document order) with a 400
+// naming it: { "error": "unsupported field: <name>" }. Known-field
+// validation is left to store.add / store.setAmount.
+function rejectUnknownFields(body, allowed) {
+  for (const key of Object.keys(body)) {
+    if (!allowed.has(key)) {
+      throw new UnsupportedFieldError(key);
+    }
+  }
+}
+
 export async function createInvoice(store, req, res) {
   const body = await readJsonBody(req);
+  // Unknown fields are rejected before known-field validation so a typo'd
