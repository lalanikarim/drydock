+test("POST /invoices with an unknown field returns 400 naming it and creates nothing", async () => {
+  const before = await api("GET", "/invoices");
+  const res = await api("POST", "/invoices", { customerId: "unknown-field-c1", amountCents: 100, foo: true });
+  assert.equal(res.status, 400);
+  assert.equal(res.body.error, "unsupported field: foo");
+  // Nothing created: list unchanged and no such customer exists.
+  const after = await api("GET", "/invoices");
+  assert.equal(after.body.totalCount, before.body.totalCount);
+  assert.ok(!after.body.invoices.some((i) => i.customerId === "unknown-field-c1"));
+});
+
+test("POST /invoices names the first unknown field in body order", async () => {
+  const res = await api("POST", "/invoices", { customerId: "c1", zeta: 1, amountCents: 100, alpha: 2 });
+  assert.equal(res.status, 400);
+  assert.equal(res.body.error, "unsupported field: zeta");
+});
+
+test("POST /invoices rejection does not consume an id", async () => {
+  const first = await api("POST", "/invoices", { customerId: "id-reserve-a", amountCents: 100 });
+  assert.equal(first.status, 201);
+  const rejected = await api("POST", "/invoices", { customerId: "id-reserve-b", amountCents: 100, dueDate: "2026-01-01" });
+  assert.equal(rejected.status, 400);
+  assert.equal(rejected.body.error, "unsupported field: dueDate");
+  const second = await api("POST", "/invoices", { customerId: "id-reserve-c", amountCents: 100 });
+  assert.equal(second.status, 201);
+  // The rejected request consumed no id: the next create gets first.id + 1.
+  assert.equal(second.body.id, first.body.id + 1);
+});
+
+test("POST /invoices still accepts exactly the known fields (customerId, amountCents, status)", async () => {
+  const res = await api("POST", "/invoices", { customerId: "known-fields-c1", amountCents: 75, status: "open" });
+  assert.equal(res.status, 201);
+  assert.equal(res.body.customerId, "known-fields-c1");
+  assert.equal(res.body.amountCents, 75);
+  assert.equal(res.body.status, "open");
+});
+
+test("POST /invoices known-field validation errors keep their messages and status codes", async () => {
+  const cases = [
+    [{}, "customerId must be a non-empty string"],
+    [{ customerId: "c1", amountCents: -5 }, "amountCents must be a positive integer"],
+    [{ customerId: "c1", amountCents: 100, status: "bogus" }, "unknown status: bogus"],
+  ];
+  for (const [body, message] of cases) {
+    const res = await api("POST", "/invoices", body);
+    assert.equal(res.status, 400);
+    assert.equal(res.body.error, message);
+  }
+});
+
+test("PATCH and POST reject unknown fields with the same message shape", async () => {
+  const created = await api("POST", "/invoices", { customerId: "shared-rule-c1", amountCents: 100 });
+  const post = await api("POST", "/invoices", { customerId: "c1", amountCents: 100, sneaky: true });
+  assert.equal(post.body.error, "unsupported field: sneaky");
+  const patch = await api("PATCH", `/invoices/${created.body.id}`, { amountCents: 500, sneaky: true });
+  assert.equal(patch.status, 400);
+  assert.equal(patch.body.error, "unsupported field: sneaky");
+});
+
