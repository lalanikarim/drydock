   // Validation rules for creating an invoice. Shared by add() and the
   // batch endpoint so both reject the same bad input with the same text.
-  validate({ customerId, amountCents, status = "open" }) {
+  validate(body) {
+    // A body that is not a JSON object (null, string, number, array) cannot
+    // carry customerId/amountCents; report its shape instead of letting the
+    // destructuring below produce an engine-internal TypeError message.
+    if (body === null || typeof body !== "object" || Array.isArray(body)) {
+      throw new TypeError("invoice must be an object");
+    }
+    const { customerId, amountCents, status = "open" } = body;
     if (typeof customerId !== "string" || customerId.length === 0) {
       throw new TypeError("customerId must be a non-empty string");
     }
