+// Issue #72: a batch element that is valid JSON but not an object (null,
+// string, array) must be rejected with the same shape-describing message and
+// invoices[i]: prefix — never with engine-internal text like V8's
+// "Cannot destructure property ..." or a misattributed field error.
+test("batch create rejects every non-object element consistently (issue #72)", async () => {
+  const before = await api("GET", "/invoices");
+  for (const [index, element] of [[0, null], [1, "nope"], [0, [1]], [1, 42]]) {
+    const invoices = index === 0 ? [element] : [{ customerId: "shape-ok", amountCents: 5 }, element];
+    const res = await api("POST", "/invoices/batch", { invoices });
+    assert.equal(res.status, 400);
+    assert.equal(res.body.error, `invoices[${index}]: invoice must be an object`);
+    // No engine-internal text reaches the client.
+    assert.ok(!/destructure/i.test(res.body.error));
+  }
+  // A rejected batch leaves nothing behind.
+  const after = await api("GET", "/invoices");
+  assert.equal(after.body.totalCount, before.body.totalCount);
+  assert.ok(!after.body.invoices.some((i) => i.customerId === "shape-ok"));
+});
+
+// The guard lives in the shared LedgerStore.validate, so POST /invoices
+// reports a non-object body the same way instead of leaking V8's wording.
+test("POST /invoices rejects a null body without engine-internal text (issue #72)", async () => {
+  const res = await fetch(`http://127.0.0.1:${ctx.port}/invoices`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: "null",
+  });
+  assert.equal(res.status, 400);
+  const body = await res.json();
+  assert.equal(body.error, "invoice must be an object");
+});
+
