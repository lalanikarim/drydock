+// Issue #87: the batch envelope is checked with the same unknown-field rule
+// as POST /invoices and PATCH — a top-level field other than `invoices` is
+// rejected naming that key, and a rejected batch writes nothing.
+test("batch create rejects an unknown top-level field alongside a valid batch (issue #87)", async () => {
+  const before = await api("GET", "/invoices");
+  const res = await api("POST", "/invoices/batch", {
+    invoices: [{ customerId: "batch-env-1", amountCents: 50 }],
+    nope: 1,
+  });
+  assert.equal(res.status, 400);
+  assert.equal(res.body.error, "unsupported field: nope");
+  // A rejected batch leaves nothing behind.
+  const after = await api("GET", "/invoices");
+  assert.equal(after.body.totalCount, before.body.totalCount);
+  assert.ok(!after.body.invoices.some((i) => i.customerId === "batch-env-1"));
+});
+
+test("batch create names the first unknown top-level key in body order (issue #87)", async () => {
+  const res = await api("POST", "/invoices/batch", {
+    customorId: "c",
+    invoices: [{ customerId: "batch-env-2", amountCents: 50 }],
+  });
+  assert.equal(res.status, 400);
+  assert.equal(res.body.error, "unsupported field: customorId");
+});
+
+test("batch create well-formed batch still succeeds (issue #87)", async () => {
+  const before = await api("GET", "/invoices");
+  const res = await api("POST", "/invoices/batch", {
+    invoices: [{ customerId: "batch-ok-1", amountCents: 10 }],
+  });
+  assert.equal(res.status, 201);
+  assert.equal(res.body.invoices.length, 1);
+  const after = await api("GET", "/invoices");
+  assert.equal(after.body.totalCount, before.body.totalCount + 1);
+});
+
