<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  drydock failed-delivery sweep (#107, #133) — source of truth for the installed unit.

  This file used to be referenced by fleet/enable-self-work.md and never committed, so the installed job was
  the only copy of "what gets swept". That is how engram was onboarded, started receiving webhooks, and stayed
  unswept: the target list lived here and nowhere the factory could see it. Targets are now DERIVED from
  factory/repo-registry.json (`--from-registry`), so adding an enabled repo without a `webhookId` produces a
  loud line in this job's log instead of silence.

  Report-only: no --apply. Detection is automated; recovery stays a human call with `--only <id>`, because
  acting on a schedule can resurrect work for an issue that closed hours ago.

  Exit code: 0 = every swept repo clean, 1 = undelivered events found in at least one, 2 = usage/credential
  problem OR nothing was swept at all (a sweep that examined zero repos is not a passing sweep).

  --experimental-strip-types is required: the sweep imports factory/repo-registry.ts. Dropping the flag makes
  the job die at import time with a syntax error, and launchd reports that as an ordinary non-zero exit.

  Token: resolved from GITHUB_TOKEN/GH_TOKEN, else `gh auth token` tried as `gh`, /opt/homebrew/bin/gh,
  /usr/local/bin/gh — launchd does not inherit a login shell's PATH. No secret lives here.

  Install / verify (see runbook §7):
    cp fleet/launchd/com.drydock.redeliver.plist.example ~/Library/LaunchAgents/com.drydock.redeliver.plist
    plutil -lint ~/Library/LaunchAgents/com.drydock.redeliver.plist
    launchctl bootout gui/$(id -u)/com.drydock.redeliver 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.drydock.redeliver.plist
    launchctl kickstart -k gui/$(id -u)/com.drydock.redeliver
    tail -30 ~/Library/Logs/drydock-redeliver.log        # must name EVERY deployed repo
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.drydock.redeliver</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/karim/.hermes/node/bin/node</string>
    <string>--experimental-strip-types</string>
    <string>/Users/karim/Projects/drydock/fleet/redeliver-failed.mjs</string>
    <string>--from-registry</string>
    <string>--since</string>
    <string>24h</string>
    <string>--skip-file</string>
    <string>/Users/karim/Projects/drydock/fleet/data/acknowledged-deliveries.txt</string>
    <string>--state-file</string>
    <string>/Users/karim/Projects/drydock/fleet/data/last-sweep.json</string>
  </array>

  <!-- Each run is one authenticated API call per page of delivery history, per repo. The window of silent
       loss grows with the interval, so this is a cost/detection trade rather than a default. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/Users/karim/Projects/drydock</string>

  <key>StandardOutPath</key>
  <string>/Users/karim/Library/Logs/drydock-redeliver.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/karim/Library/Logs/drydock-redeliver.log</string>

  <key>KeepAlive</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
