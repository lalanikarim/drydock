<?xml version="1.0" encoding="UTF-8"?>
<!--
  Failed-delivery sweep as a launchd job (#110). TEMPLATE — copy it, fill in every
  __PLACEHOLDER__, and install:

    cp fleet/launchd/com.drydock.redeliver.plist.example \
       ~/Library/LaunchAgents/com.drydock.redeliver.plist
    # edit: repo, hook id, paths, interval
    launchctl load ~/Library/LaunchAgents/com.drydock.redeliver.plist
    launchctl start com.drydock.redeliver          # run once, now
    tail -f /Users/__USER__/Library/Logs/drydock-redeliver.log
    launchctl unload ~/Library/LaunchAgents/com.drydock.redeliver.plist   # stop

  Why launchd and not cron (the decision #110 was waiting on): a laptop sleeps. `cron` skips the jobs it
  would have run during sleep and never catches up, which is precisely the window in which webhook
  deliveries fail. launchd's StartInterval timer resumes when the machine wakes, and KeepAlive=false
  means each interval is one short-lived process rather than a daemon to supervise.

  Two properties chosen on purpose:

  * **Report-only.** No --apply. A scheduled sweep that acts can resurrect work for an issue closed hours
    ago; recovery stays a human decision made with `--only <id>`. The job's value is detection.
  * **Exit code means something.** 0 = window clean, 1 = undelivered events needing attention, 2 = usage or
    credential problem. launchd ignores it; the log and any mail wrapper do not. This was broken for a day
    (main() returned a code nothing propagated), which is why the check asserts on process exit and not on a
    return value.

  The token comes from the environment launchd gives the job; on this machine `gh auth token` is the
  resolution path (see resolveToken in fleet/redeliver-failed.mjs), so no secret is stored in the plist.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.drydock.redeliver</string>

  <!-- Absolute paths everywhere: launchd gives you no login shell, so neither PATH nor version-manager
       shims exist here. Use `readlink -f "$(command -v node)"` for the real binary. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/__USER__/Projects/drydock/fleet/redeliver-failed.mjs</string>
    <string>--repo</string>
    <string>lalanikarim/drydock</string>
    <string>--hook</string>
    <string>__HOOK_ID__</string>

    <!-- Rolling window. Without it the job reports ancient retained history forever and exit 1 stops
         meaning "something is failing now". Accepts 24h / 90m / 7d / 30s or an absolute timestamp. -->
    <string>--since</string>
    <string>24h</string>

    <!-- Acknowledge list: ids a human reviewed and chose not to re-drive (one per line, # comments).
         Excluded from the exit code but still counted as `acknowledged` in the state file. Optional; a
         missing file means no acknowledgements, never silence. -->
    <string>--skip-file</string>
    <string>/Users/__USER__/Projects/drydock/fleet/data/acknowledged-deliveries.txt</string>

    <string>--state-file</string>
    <string>/Users/__USER__/Projects/drydock/fleet/data/last-sweep.json</string>
  </array>

  <!-- 900s = 15 minutes. Each run is one authenticated API call per page of delivery history; the
       window of silent loss grows with the interval, so this is a cost/detection trade, not a default
       to leave at an hour. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <!-- Fire immediately on load so the first state file appears without waiting 15 minutes. -->
  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/Users/__USER__/Projects/drydock</string>

  <key>StandardOutPath</key>
  <string>/Users/__USER__/Library/Logs/drydock-redeliver.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/__USER__/Library/Logs/drydock-redeliver.log</string>

  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
